# Copy to backend/.env and adjust for your environment.

PORT=3000
NODE_ENV=development

# SQLite database file (":memory:" for an ephemeral DB)
DB_PATH=./data/roadmap.db

# CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800
SESSION_TTL_MS=604800000

# Bootstrap admin (only created when the users table is empty)
ADMIN_EMAIL=admin@roadmap.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10
OAUTH_RATE_LIMIT_MAX=30

# Cache TTLs (seconds)
CACHE_LIST_TTL=60
CACHE_DETAIL_TTL=300
