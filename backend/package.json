{
  "name": "roadmap-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RESTful API backend for roadmap.sh rebuild - Node.js + Express + SQLite",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "vitest": "^3.0.9"
  }
}
